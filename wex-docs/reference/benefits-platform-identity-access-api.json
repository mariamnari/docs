    "/identity/v1/persons/lookup": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Lookup Persons Identity",
        "description": "This unique identifier will serve as a key reference for accessing and managing data associated with the specified person entity.                                                                                                                     \r\nTo execute a call to lookup a person identity, a valid <b>JWT Token</b> is required for authentication.                                                                     \r\nImportant: administrator_code, employer_code and consumer_identifier are required for the lookup\r\n, and the value for consumer_identifier must match the ConsumerIdentifierType.",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "description": "Optional correlation ID associated with the request, comprised of alphanumeric or hyphen characters up to 36 characters in length.",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "The basic information about the person identity to retrieve",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/PersonIdentityDto"
                  }
                ]
              }
            },
            "text/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/PersonIdentityDto"
                  }
                ]
              }
            },
            "application/*+json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/PersonIdentityDto"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PersonIdentityLookupResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonIdentityLookupResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonIdentityLookupResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              }
            }
          }
        }
      }
    },
    "/identity/health/liveness": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Get Liveness",
        "description": "This endpoint is used to check the liveness of the service. This is just a simple ping to see if the service is alive.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "results": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Error: response status is 503",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "results": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
