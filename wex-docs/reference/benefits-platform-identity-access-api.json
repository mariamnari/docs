            "type": "string"
          },
          "qualifying_event_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PersonCDH": {
        "type": "object",
        "properties": {
          "administrator_code": {
            "type": "string",
            "nullable": true
          },
          "employer_code": {
            "type": "string",
            "nullable": true
          },
          "individual_id": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PersonIdentityDto": {
        "type": "object",
        "properties": {
          "employer_code": {
            "type": "string",
            "nullable": true
          },
          "administrator_code": {
            "type": "string",
            "nullable": true
          },
          "consumer_identifier": {
            "type": "string",
            "nullable": true
          },
          "consumer_identifier_type": {
            "enum": [
              "EmployeeNumber",
              "SocialSecurityNumber",
              "ExchangeId",
              "EmployerEmployeeId"
            ],
            "type": "string"
          },
          "type": {
            "enum": [
              "Consumer",
              "AuthorizedSigner",
              "Dependent",
              "Contact"
            ],
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PersonIdentityLookupResponse": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "page_size": {
            "type": "integer",
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonIdentityResponse"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PersonIdentityResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "parent": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
