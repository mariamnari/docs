            "type": "string"
          },
          "billing_start_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "billing_type": {
            "enum": [
              "RETIREE",
              "PREMIUMPAY",
              "CASHPAY",
              "FMLA",
              "LOANREPAYMENT",
              "LEAVEOFABSENCE",
              "LTDPREMIUM",
              "DISABILITYPREMIUM",
              "CUSTOM",
              "STDPREMIUM"
