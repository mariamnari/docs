{
  "openapi": "3.0.1",
  "info": {
    "title": "Benefits Platform Identity Access API",
    "description": "The 'IAM', Identity Access Management API is a component of the Benefits Platform designed to retrieve Identity information for entities such as \r\n\t\t                administrators, employers, partners, and participants. The Benefits \r\n\t\t                Platform encompasses various benefits management systems such as HSA, FSA, HRA management, \r\n\t\t                and COBRA coverage.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://platform.uat.benefits.wexglobal.com",
      "description": "UAT"
    }
  ],
  "paths": {
    "/identity/v1/business/{business_id}": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "Get Business Identity",
        "description": "This route will only return the Business if it exists in the new Benefits Platform Identity.\r\nTo execute a call to lookup a business identity, a valid <b>JWT Token</b> is required for authentication.",
        "parameters": [
          {
            "name": "business_id",
            "in": "path",
            "description": "The Business Identity GUID to fetch data",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "description": "Optional correlation ID associated with the request, comprised of alphanumeric or hyphen characters up to 36 characters in length.",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessIdentityResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessIdentityResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessIdentityResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              }
            }
          }
        }
      }
    },
    "/identity/v1/business/lookup": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Lookup Businesses Identity",
        "description": "This unique identifier will serve as a key reference for accessing and managing data associated with the specified business entity.                                                                                                                     \r\nTo execute a call to lookup a business identity, a valid <b>JWT Token</b> is required for authentication.                                                                     \r\nImportant: Both administrator_code and employer_code are required to lookup a business employer. \r\nWhereas an employer_code value is not required to retrieve an Administrator Business.",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "description": "Optional correlation ID associated with the request, comprised of alphanumeric or hyphen characters up to 36 characters in length.",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "The basic information about the business identity to retrieve",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/BusinessIdentityDto"
                  }
                ]
              }
            },
            "text/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/BusinessIdentityDto"
                  }
                ]
              }
            },
            "application/*+json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/BusinessIdentityDto"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessIdentityLookupResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessIdentityLookupResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessIdentityLookupResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResult"
                }
              }
            }
          }
        }
      }
    },
