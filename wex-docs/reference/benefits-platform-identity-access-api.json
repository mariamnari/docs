            "nullable": true
          },
          "company_id": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "employer_id": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BusinessCDH": {
        "type": "object",
        "properties": {
          "administrator_code": {
            "type": "string",
            "nullable": true
          },
          "administrator_id": {
            "type": "integer",
            "format": "int32"
          },
          "employer_code": {
            "type": "string",
            "nullable": true
          },
          "employer_id": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BusinessIdentityDto": {
        "type": "object",
        "properties": {
          "administrator_code": {
            "type": "string",
            "nullable": true
          },
          "employer_code": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BusinessIdentityLookupResponse": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "page_size": {
            "type": "integer",
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BusinessIdentityResponse"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BusinessIdentityResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "parent": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "type": {
            "enum": [
              "Administrator",
              "Employer",
              "BusinessParty",
              "Carrier",
              "Division",
              "Partner",
              "Vendor"
            ],
            "type": "string"
          },
          "cdh": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/BusinessCDH"
              }
            ],
            "nullable": true
          },
          "cdb": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/BusinessCDB"
              }
            ],
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ExceptionResult": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "additional_prop": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PersonCDBResponse": {
        "type": "object",
        "properties": {
          "partner": {
            "type": "string",
            "nullable": true
          },
          "company_id": {
            "type": "integer",
            "format": "int32"
          },
          "member_id": {
            "type": "integer",
            "format": "int32"
          },
          "billing_frequency": {
            "enum": [
              "MONTHLY",
              "WEEKLY",
              "BIWEEKLY",
              "QUARTERLY",
              "YEARLY",
              "SEMIMONTHLY"
