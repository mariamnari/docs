  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "address_line1": {
            "type": "string",
            "description": "The first line of the consumer's address.",
            "nullable": true
          },
          "address_line2": {
            "type": "string",
            "description": "The second line of the consumer's address.",
            "nullable": true
          },
          "city": {
            "type": "string",
            "description": "The city of the consumer's address.",
            "nullable": true
          },
          "state": {
            "type": "string",
            "description": "The state or province of the consumer's address.",
            "nullable": true
          },
          "country": {
            "type": "string",
            "description": "The country of the consumer's address.",
            "nullable": true
          },
          "address_type": {
            "enum": [
              "BUSINESS_MAILING",
              "HOME_ADDRESS",
              "MAILING_ADDRESS",
              "DEFAULT"
            ],
            "type": "string",
            "description": "The type of address, such as business, home, or mailing."
          }
        },
        "additionalProperties": false,
        "description": "Address object with details about a consumer's address."
      },
      "CitizenshipInfo": {
        "type": "object",
        "properties": {
          "citizenship": {
            "enum": [
              "UNKNOWN",
              "US_CITIZEN",
              "RESIDENT_ALIEN",
              "NON_RESIDENT_ALIEN"
            ],
            "type": "string",
            "description": "Consumer's citizenship status.",
            "nullable": true
          },
          "country": {
            "type": "string",
            "description": "Consumer's country of citizenship.",
            "nullable": true
          },
          "employment_status": {
            "enum": [
              "EMPLOYED",
              "NOT_EMPLOYED",
              "SELF_EMPLOYED",
              "RETIRED",
              "UNKNOWN"
            ],
            "type": "string",
            "description": "Consumer's employment status related to citizenship details.",
            "nullable": true
          },
          "employer": {
            "type": "string",
            "description": "Name of consumer's employer.",
            "nullable": true
          },
          "job_title": {
            "type": "string",
            "description": "Consumer's job title.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Citizenship Information Object with details about a consumer's citizenship, including the country and status."
      },
      "Consumer": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the consumer in the system.",
            "format": "uuid"
          },
          "individual_id": {
            "type": "integer",
            "description": "Numeric identifier associated with the individual.",
            "format": "int32"
          },
          "consumer_id": {
            "type": "integer",
            "description": "Numeric identifier specific to the consumer.",
            "format": "int32",
            "nullable": true
          },
          "first_name": {
            "type": "string",
            "description": "Consumer's first name.",
            "nullable": true
          },
          "middle_name": {
            "type": "string",
            "description": "Consumer's middle name.",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "description": "Consumer's last name.",
            "nullable": true
          },
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Address"
            },
            "description": "List of addresses associated with the consumer.",
            "nullable": true
          },
          "email_address": {
            "type": "string",
            "description": "Consumer's primary email address.",
            "nullable": true
          },
          "alternate_email_address": {
            "type": "string",
            "description": "Consumer's alternate email address.",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "description": "Consumer's gender.",
            "nullable": true
          },
          "marital_status": {
            "type": "string",
            "description": "Consumer's marital status.",
            "nullable": true
          },
          "consumer_communication_id": {
            "type": "string",
            "description": "Unique identifier for the consumer used by the employer.",
            "nullable": true
          },
          "user_name": {
            "type": "string",
            "description": "Consumer's username.",
            "nullable": true
          },
          "phone_numbers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PhoneNumber"
            },
            "description": "List of phone numbers associated with the consumer.",
            "nullable": true
          },
          "employment_info": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EmploymentInfo"
              }
            ],
            "description": "Employment information associated with the consumer.",
            "nullable": true
          },
          "citizenship_info": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CitizenshipInfo"
              }
            ],
            "description": "Citizenship information associated with the consumer.",
            "nullable": true
          },
          "identification_info": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IdentificationInfo"
              }
            ],
            "description": "Identification information associated with the consumer.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Consumer Object with details about a consumer, including their addresses, phone numbers, employment info, citizenship info, and identification info."
      },
      "Dependent": {
        "required": [
          "dependent_id",
          "first_name",
          "id",
          "last_name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the consumer linked to the dependent.",
            "format": "uuid"
          },
          "dependent_id": {
            "type": "integer",
            "description": "Numeric identifier assigned to the dependent.",
            "format": "int32"
          },
          "first_name": {
            "minLength": 1,
            "type": "string",
            "description": "Dependent's first name."
          },
          "middle_name": {
            "type": "string",
            "description": "Dependent's middle name.",
            "nullable": true
          },
          "last_name": {
            "minLength": 1,
            "type": "string",
            "description": "Dependent's last name."
          },
          "birth_date": {
            "type": "string",
            "description": "Dependent's date of birth.",
            "format": "date",
            "nullable": true
          },
          "relationship": {
            "enum": [
              "SPOUSE",
              "CHILD",
              "DOMESTIC_PARTNER",
              "OTHER"
            ],
            "type": "string",
            "description": "Dependent's relationship to the consumer."
          },
          "ssn": {
            "type": "string",
            "description": "Dependent's social security number.",
            "nullable": true
          },
          "gender": {
            "enum": [
              "UNKNOWN",
              "MALE",
              "FEMALE",
              "CUSTOM"
            ],
            "type": "string",
            "description": "Dependent's gender."
          },
          "custom_gender_name": {
            "type": "string",
            "description": "Custom text describing the dependent's gender, if applicable.",
            "nullable": true
          },
          "full_time_student": {
            "type": "boolean",
            "description": "Indicates whether the dependent is a full-time student."
          },
          "status": {
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "PENDING",
              "ARCHIVED"
            ],
            "type": "string",
            "description": "Dependent's status within the system (e.g., Active)."
          },
          "external_dependent_id": {
            "type": "string",
            "description": "An external identifier assigned to the dependent.",
            "nullable": true
          },
          "dependent_number": {
            "type": "string",
            "description": "Numeric identifier for the dependent.",
            "nullable": true
          },
