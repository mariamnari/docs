{
  "openapi": "3.0.1",
  "info": {
    "title": "Benefits Platform Persons API",
    "description": "The 'Person' web service is a component of the Benefits Platform designed to retrieve detailed \r\n\t\t\t\t\t\tinformation about employees, consumers, dependents, and authorized signers. The Benefits \r\n\t\t\t\t\t\tPlatform encompasses various benefits management systems such as HSA, FSA, HRA management, \r\n\t\t\t\t\t\tand COBRA coverage.",
    "contact": {
      "name": "WEX Inc."
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://platform.uat.benefits.wexglobal.com/",
      "description": "UAT"
    }
  ],
  "paths": {
    "/persons/v1/consumers/{person_id}": {
      "get": {
        "tags": [
          "Persons"
        ],
        "summary": "Get Consumer",
        "description": "Retrieve basic information about a consumer. A consumer is a person mapped into a plan.",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "description": "The GUID generated by the Identity Management Service for accessing this specific person and its related resources.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "description": "Optional correlation ID associated with the request, comprised of alphanumeric or hyphen characters up to 36 characters in length.",
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved consumer information.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Consumer"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Consumer"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Consumer"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request. Check query parameters.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. Authentication failed.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found.  No Consumer found for supplied ID.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
