    "/persons/health/liveness": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Get Liveness",
        "description": "This endpoint is used to check the liveness of the service. This is just a simple ping to see if the service is alive.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "results": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Error: response status is 503",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "results": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
